{
  "welcomeFile": "/requests/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/requests/eams/(.*)$",
      "target": "/eams/$1",
      "destination": "srv-api",
      "csrfProtection": true,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/assets/eams/(.*)$",
      "target": "/eams/$1",
      "destination": "srv-api",
      "csrfProtection": true,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/eams/(.*)$",
      "target": "/eams/$1",
      "destination": "srv-api",
      "csrfProtection": true,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
