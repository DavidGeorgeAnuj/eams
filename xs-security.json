{
  "xsappname": "eams",
  "tenant-mode": "dedicated",
  "scopes": [
    { "name": "$XSAPPNAME.Employee", "description": "Employee" },
    { "name": "$XSAPPNAME.Manager", "description": "Manager" },
    { "name": "$XSAPPNAME.AssetAdmin", "description": "Asset Administrator" },
    { "name": "$XSAPPNAME.ITSupport", "description": "IT Support" },
    { "name": "$XSAPPNAME.SysAdmin", "description": "System Administrator" }
  ],
  "attributes": [],
  "role-templates": [
    { "name": "Employee", "description": "Employee", "scope-references": ["$XSAPPNAME.Employee"] },
    { "name": "Manager", "description": "Manager", "scope-references": ["$XSAPPNAME.Employee", "$XSAPPNAME.Manager"] },
    { "name": "AssetAdmin", "description": "Asset Administrator", "scope-references": ["$XSAPPNAME.AssetAdmin"] },
    { "name": "ITSupport", "description": "IT Support", "scope-references": ["$XSAPPNAME.ITSupport"] },
    { "name": "SysAdmin", "description": "System Administrator", "scope-references": ["$XSAPPNAME.SysAdmin"] }
  ]
}
